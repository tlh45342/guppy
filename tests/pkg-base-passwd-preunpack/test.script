logfile pkg-base-passwd-preunpack.log

echo === fresh target: base-passwd creates Debian master account files ===
create pkg-base-passwd-preunpack.img 16M
use -i pkg-base-passwd-preunpack.img /dev/a
gpt init /dev/a
gpt add /dev/a --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target
pkg install local:base-passwd_3.6.7_amd64.deb /target
pkg status /target base-passwd
cat /target/etc/passwd
cat /target/etc/group
stat /target/usr/share/base-passwd/guppy-marker.txt

echo === existing target: base-passwd must preserve account files ===
create pkg-base-passwd-preserve.img 16M
use -i pkg-base-passwd-preserve.img /dev/b
gpt init /dev/b
gpt add /dev/b --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/b
mkfs.ext2 /dev/b1
mount /dev/b1 /target2
mkdir /target2/etc
echo guppy-existing-passwd > /target2/etc/passwd
echo guppy-existing-group > /target2/etc/group
pkg install local:base-passwd_3.6.7_amd64.deb /target2
cat /target2/etc/passwd
cat /target2/etc/group
logfile off
