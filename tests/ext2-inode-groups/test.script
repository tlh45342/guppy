logfile ext2-inode-groups.log
create ext2-inode-groups.vdi 300M
use -i ext2-inode-groups.vdi /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 614366
partscan /dev/a
mkfs.ext2 /dev/a1 --label INODEGROUP
mount /dev/a1 /target
mkdir -p /target/many
