logfile accounts.log
create accounts.img 16M
use -i accounts.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 32734
partscan /dev/a
mkfs.ext2 /dev/a1 --label ACCOUNTS
mount /dev/a1 /target
useradd -R /target -u 1001 -c TestUser -s /bin/sh alice
passwd -R /target alice secret123
cat /target/etc/passwd
cat /target/etc/group
cat /target/etc/shadow
stat /target/home/alice
useradd -R /target -M bob
passwd -R /target --hash $5$testsalt$0nJaoNBqGOzZuuF0ljY7kJtJzaDPzCc.//FOE7ialA8 bob
cat /target/etc/passwd
cat /target/etc/shadow
logfile off
