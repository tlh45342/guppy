logfile pkg-base-files-install.log

use -i H:\debian-13.6.0-amd64-netinst.iso /dev/b
mount /dev/b /iso

create pkg-target.img 32M
use -i pkg-target.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 65502
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

pkg install /iso/pool/main/b/base-files/base-files_13.8+deb13u6_amd64.deb /target

cat /target/etc/debian_version
stat /target/bin
stat /target/lib64
stat /target/etc/os-release

logfile off
