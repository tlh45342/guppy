logfile ext2-mount.log
create ext2-mount.img 16M
use -i ext2-mount.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 32734
partscan /dev/a
mkfs.ext2 /dev/a1 --label GUPPYTEST
mount /dev/a1 /target
mount
mkdir -p /target/etc
echo ext2-probe-ok > /target/etc/probe.txt
cat /target/etc/probe.txt
stat /target/etc/probe.txt
logfile off
