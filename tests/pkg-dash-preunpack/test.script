logfile pkg-dash-preunpack.log

echo === fresh target: dash audited preinst + bootstrap /bin/sh handoff ===
create pkg-dash-preunpack.img 16M
use -i pkg-dash-preunpack.img /dev/a
gpt init /dev/a
gpt add /dev/a --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

echo bootstrap-shell > /target/usr/bin/sh
chmod 755 /target/usr/bin/sh
stat /target/usr/bin/sh

pkg install local:dash_0.5.12-12_amd64.deb /target
pkg status /target dash
stat /target/usr/bin/dash
readlink /target/usr/bin/sh
cat /target/usr/share/doc/dash/guppy-marker.txt
logfile off
