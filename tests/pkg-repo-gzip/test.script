logfile pkg-repo-gzip.log
create repo-gzip.img 32M
use -i repo-gzip.img /dev/a
gpt init /dev/a
gpt add /dev/a --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target
mkdir -p /target/repo/dists/test/main/binary-amd64
lcp Packages.gz /target/repo/dists/test/main/binary-amd64/Packages.gz
pkg repo add /target/repo
pkg repo list
pkg lookup gzip-fixture
pkg path gzip-fixture
logfile off
