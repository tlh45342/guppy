logfile pkg-base-files-preunpack.log
create pkg-base-files-preunpack.img 24M
use -i pkg-base-files-preunpack.img /dev/a
gpt init /dev/a
gpt add /dev/a --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

echo === establish existing merged-/usr aliases used by the boot scaffold ===
mkdir -p /target/usr/bin
mkdir -p /target/usr/lib
mkdir -p /target/usr/sbin
ln -s usr/bin /target/bin
ln -s usr/lib /target/lib
ln -s usr/sbin /target/sbin

echo === establish libc6-owned pre-unpack state first ===
pkg install local:libc6_2.41-12+deb13u3_amd64.deb /target
pkg status /target libc6

echo === register synthetic Debian repository ===
mkdir -p /target/repo/dists/test/main/binary-amd64
lcp Packages /target/repo/dists/test/main/binary-amd64/Packages
mkdir -p /target/repo/pool/main/b/base-files
mkdir -p /target/repo/pool/main/m/mawk
lcp base-files_13.8+deb13u6_amd64.deb /target/repo/pool/main/b/base-files/base-files_13.8+deb13u6_amd64.deb
lcp mawk_1.3.4.20250131-1_amd64.deb /target/repo/pool/main/m/mawk/mawk_1.3.4.20250131-1_amd64.deb
pkg repo add /target/repo

echo === install base-files through public repository path ===
pkg install base-files /target
pkg status /target mawk
pkg status /target base-files

echo === file-trigger registry ===
cat /target/var/lib/dpkg/triggers/File
pkg triggers /target

echo === merged-/usr aliases after payload unpack ===
readlink /target/bin
readlink /target/lib
readlink /target/lib64
readlink /target/sbin

echo === DEP17 diversion state ===
cat /target/var/lib/dpkg/diversions

echo === public re-install should recognize package already present ===
pkg install base-files /target
pkg status /target base-files
cat /target/var/lib/dpkg/diversions
logfile off
