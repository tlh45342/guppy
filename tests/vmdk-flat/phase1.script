logfile vmdk-flat.log

; First VMDK implementation: ESXi-oriented descriptor + external flat extent.
create fixed-test.vmdk 20M --vmdk-type flat
diskq fixed-test.vmdk
use -i fixed-test.vmdk /dev/a
use

gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 40926
partscan /dev/a
gpt print /dev/a
mkfs.ext2 /dev/a1 --label VMDKFLAT
mount /dev/a1 /target
mkdir -p /target/etc
echo vmdk-flat-persistence > /target/etc/vmdk-test.txt
cat /target/etc/vmdk-test.txt
stat /target/etc/vmdk-test.txt
diskq fixed-test.vmdk

logfile off
