logfile metadata.log
create metadata.img 16M
use -i metadata.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 32734
partscan /dev/a
mkfs.ext2 /dev/a1 --label METADATA
mount /dev/a1 /target
mkdir -p /target/usr/bin
echo metadata-persistence > /target/usr/bin/guppy-test
stat /target/usr/bin/guppy-test
chmod 755 /target/usr/bin/guppy-test
stat /target/usr/bin/guppy-test
logfile off
