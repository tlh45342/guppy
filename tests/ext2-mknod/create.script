logfile ext2-mknod-create.log
create ext2-mknod.img 16M
use -i ext2-mknod.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 32734
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target
mkdir /target/dev
mknod /target/dev/console c 1 0
mknod /target/dev/null c 1 3
mknod /target/dev/zero c 1 5
mknod /target/dev/example b 8 0
stat /target/dev/console
stat /target/dev/null
stat /target/dev/zero
stat /target/dev/example
ls -l /target/dev
logfile off
