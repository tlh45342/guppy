logfile pkg-configure.log
create pkg-configure.img 16M
use -i pkg-configure.img /dev/a
gpt init /dev/a
gpt add /dev/a --type linuxfs --name rootfs --start 1M --size 100%
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target
mkdir /target/var
mkdir /target/var/lib
mkdir /target/var/lib/dpkg
mkdir /target/var/lib/dpkg/info
mkdir /target/usr
mkdir /target/usr/lib
mkdir /target/usr/lib/tmpfiles.d
lcp status /target/var/lib/dpkg/status
lcp config-demo.postinst /target/var/lib/dpkg/info/config-demo.postinst
lcp config-demo.triggers /target/var/lib/dpkg/info/config-demo.triggers
lcp config-demo.conf /target/usr/lib/tmpfiles.d/config-demo.conf
pkg status /target config-demo
pkg configure config-demo /target
pkg status /target config-demo
stat /target/run/config-demo
cat /target/var/lib/dpkg/triggers/Unincorp
logfile off
