#!/bin/sh
set -e

if [ "$1" = configure ] && dpkg --compare-versions "$2" lt 0.9 ; then
  rm -f /etc/config-demo/old.cache
fi

# Automatically added by dh_installtmpfiles/13.24.1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
