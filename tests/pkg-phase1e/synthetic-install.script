logfile synthetic-state.log
create synthetic-state.img 16M
use -i synthetic-state.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 32734
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target
pkg install local:control-test.deb /target
cat /target/var/lib/dpkg/status
cat /target/var/lib/dpkg/info/guppy-control-test.list
stat /target/var/lib/dpkg/info/guppy-control-test.postinst
logfile off
