logfile pkg-dpkg-state.log

use -i H:\debian-13.6.0-amd64-netinst.iso /dev/b
mount /dev/b /iso

create pkg-state.img 32M
use -i pkg-state.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 65502
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

pkg install /iso/pool/main/b/base-files/base-files_13.8+deb13u6_amd64.deb /target

cat /target/var/lib/dpkg/status
cat /target/var/lib/dpkg/info/base-files.list
cat /target/var/lib/dpkg/info/base-files.conffiles
cat /target/var/lib/dpkg/info/base-files.triggers

stat /target/var/lib/dpkg/info/base-files.preinst
stat /target/var/lib/dpkg/info/base-files.postinst
stat /target/var/lib/dpkg/info/base-files.postrm

logfile off
