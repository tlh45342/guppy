logfile pkg-base-passwd-state.log

use -i H:\debian-13.6.0-amd64-netinst.iso /dev/b
mount /dev/b /iso

create pkg-base-passwd-state.img 32M
use -i pkg-base-passwd-state.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 65502
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

pkg install /iso/pool/main/b/base-passwd/base-passwd_3.6.7_amd64.deb /target
pkg status /target base-passwd
cat /target/etc/passwd
cat /target/etc/group
stat /target/usr/share/base-passwd/passwd.master
stat /target/usr/share/base-passwd/group.master
stat /target/var/lib/dpkg/info/base-passwd.preinst
stat /target/var/lib/dpkg/info/base-passwd.postinst

logfile off
