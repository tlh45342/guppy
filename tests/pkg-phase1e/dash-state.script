logfile pkg-dash-state.log

use -i H:\debian-13.6.0-amd64-netinst.iso /dev/b
mount /dev/b /iso

create pkg-dash-state.img 32M
use -i pkg-dash-state.img /dev/a
gpt init /dev/a
gpt add /dev/a linuxfs rootfs 2048 65502
partscan /dev/a
mkfs.ext2 /dev/a1
mount /dev/a1 /target

echo bootstrap-shell > /target/usr/bin/sh
chmod 755 /target/usr/bin/sh
stat /target/usr/bin/sh

pkg install /iso/pool/main/d/dash/dash_0.5.12-12_amd64.deb /target
pkg status /target dash
stat /target/usr/bin/dash
readlink /target/usr/bin/sh
stat /target/var/lib/dpkg/info/dash.preinst
stat /target/var/lib/dpkg/info/dash.postinst

logfile off
